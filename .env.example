# Prefer `npm run setup`: it creates unique passwords and a signing secret.
# This example contains no usable credentials.
ACCOUNT_MODE=invite
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
PASSWORD=
PROXY_SECRET=
HOST=127.0.0.1
PORT=8080
DEFAULT_SOURCES=[]
DEFAULT_LIVE_SOURCES=[]
DEFAULT_SUBSCRIPTIONS=[]
DEFAULT_RECOMMEND_SOURCE=hot-list
